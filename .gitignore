# Generated by XcodeGen (run `xcodegen` to recreate)
*.xcodeproj
*.xcworkspace

# Xcode and SwiftPM
.build/
.swiftpm/
DerivedData/
xcuserdata/
*.xcuserstate
.DS_Store

# Personal signing values and anything that must never be committed
Config/Signing.local.xcconfig
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env
.env.*

# Local build output and CI downloads
build/
ci-artifacts/
*.xcresult
*.ipa
*.xcarchive

# Python bytecode from running the helper scripts
__pycache__/
*.pyc
