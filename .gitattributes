# Keep line endings as LF in the repository even when files are edited on Windows.
# A shell script with Windows (CRLF) line endings fails on the cloud Mac with "$'\r': command not found".
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.swift text eol=lf
*.xcconfig text eol=lf
*.plist text eol=lf
*.xcprivacy text eol=lf
*.json text eol=lf
*.md text eol=lf
*.png binary
